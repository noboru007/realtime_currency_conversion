{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/detectPrices",
        "function": "detectPrices"
      },
      {
        "source": "/getExchangeRates",
        "function": "getExchangeRates"
      },
      {
        "source": "/getCurrencyFromLocation",
        "function": "getCurrencyFromLocation"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/**", 
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "backend/functions",
    "runtime": "python311"
  }
}